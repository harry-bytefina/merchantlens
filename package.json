{
  "name": "merchantlens-copilot",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5175",
    "build": "tsc --noEmit && tsc -p tsconfig.core.json && node scripts/artifacts.mjs && vite build",
    "test": "tsc -p tsconfig.core.json && node --test tests/*.test.mjs",
    "start": "node server/server.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5175",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "typescript": "^5.6.3",
    "vite": "^6.1.0"
  }
}
